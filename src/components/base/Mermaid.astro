---
/**
 * Renders ```mermaid fenced code blocks as diagrams, GitHub-style.
 * Client-side: only loads the Mermaid library when a mermaid block
 * is present on the page. Include once in a layout (e.g. BlogLayout).
 */
---

<script>
  // Shiki-highlighted blocks render as <pre data-language="mermaid"><code>;
  // also match the plain class form just in case.
  const blocks = document.querySelectorAll<HTMLElement>(
    "pre[data-language='mermaid'] > code, pre > code.language-mermaid",
  )
  if (blocks.length > 0) {
    const isDark = document.documentElement.classList.contains("dark")
    // Mermaid is loaded from a CDN at runtime (not bundled) to keep it out of the
    // site JS unless a diagram actually needs it.
    const cdnUrl: string = "https://cdn.jsdelivr.net/npm/mermaid@11/+esm"
    const { default: mermaid } = (await import(/* @vite-ignore */ cdnUrl)) as {
      default: {
        initialize: (config: Record<string, unknown>) => void
        render: (id: string, source: string) => Promise<{ svg: string }>
      }
    }
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? "dark" : "default",
      fontFamily: "var(--font-sans, sans-serif)",
    })
    for (const [i, code] of blocks.entries()) {
      const pre = code.parentElement
      if (!pre) continue
      const source = code.textContent ?? ""
      try {
        const { svg } = await mermaid.render(`mermaid-diagram-${i}`, source)
        const figure = document.createElement("div")
        figure.className = "mermaid-diagram not-prose my-8 overflow-x-auto"
        figure.setAttribute("role", "img")
        figure.innerHTML = svg
        pre.replaceWith(figure)
      } catch (error) {
        console.error("Mermaid rendering failed:", error)
      }
    }
  }
</script>
