{
  "name": "alexanderfortin-personal-website",
  "type": "module",
  "version": "1.37.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --open",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "clean": "rm -rf dist",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --fix src scripts",
    "format": "biome format src scripts",
    "format:fix": "biome format --fix src scripts",
    "test": "vitest run tests/*.test.ts",
    "test:unit": "vitest run tests/utils.test.ts tests/blog-collection.test.ts tests/atproto-helpers.test.ts",
    "test:html": "vitest run tests/html-validation.test.ts",
    "validate": "pnpm run lint && pnpm run format && pnpm run check",
    "build:tracker": "sed \"s|__COLLECT_API_HOST__|https://cloud.umami.is|g; s|__COLLECT_API_ENDPOINT__|/api/send|g\" umami/src/tracker/index.js > public/scripts/umami.js",
    "blog-posts": "tsx scripts/blog-posts.ts",
    "bluesky": "tsx scripts/bluesky.ts",
    "changelog": "tsx scripts/changelog.ts",
    "postroll": "tsx scripts/postroll.ts",
    "standard:publication": "tsx scripts/standard-publication.ts",
    "standard:documents": "tsx scripts/standard-documents.ts",
    "profile-image": "tsx scripts/profile-image.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@lucide/astro": "^1.24.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.6",
    "svelte": "^5.56.5",
    "tailwindcss": "^4.3.2",
    "temporal-polyfill": "^1.0.1"
  },
  "devDependencies": {
    "@alexanderfortin/semantic-release-keep-a-changelog": "^0.4.9",
    "@astrojs/check": "0.9.9",
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "^2.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.1",
    "gray-matter": "^4.0.3",
    "satteri": "^0.10.5",
    "semantic-release": "^25.0.7",
    "sharp": "^0.35.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vnu-jar": "^26.7.11"
  },
  "packageManager": "pnpm@12.4.1"
}
